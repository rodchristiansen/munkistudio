# MunkiStudio release signing configuration.
# Copy this file to .env (gitignored) and fill in your values.
#
# List the Developer ID certificates in your keychain with:
#   make list-identities

# Version baked into the .app and the .pkg.
# Optional — defaults to a build timestamp, YYYY.MM.DD.HHMM.
# VERSION=2026.05.19.1430

# Developer ID Application certificate — codesigns the .app bundle.
SIGNING_IDENTITY_APP=Developer ID Application: Your Organization (YOURTEAMID)

# Developer ID Installer certificate — munkipkg signs the .pkg with this.
SIGNING_IDENTITY_INSTALLER=Developer ID Installer: Your Organization (YOURTEAMID)

# notarytool keychain profile — munkipkg notarizes and staples the .pkg
# with this. Create it once with:
#   xcrun notarytool store-credentials
NOTARIZATION_PROFILE=notarization_credentials
