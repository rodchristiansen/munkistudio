# MunkiStudio release signing configuration.
# Copy this file to .env (gitignored) and fill in your values.
#
# List the Developer ID certificates in your keychain with:
#   make list-identities
# Create the notarytool keychain profile once, interactively, with:
#   xcrun notarytool store-credentials

# Marketing version baked into the .app and the .pkg.
# Optional — defaults to 1.0.0 when unset.
# VERSION=1.0.0

# Developer ID Application certificate — signs the .app bundle.
# Format: Developer ID Application: Organization Name (TEAMID)
SIGNING_IDENTITY_APP=Developer ID Application: Your Organization (TEAMID)

# Developer ID Installer certificate — signs the .pkg.
# Format: Developer ID Installer: Organization Name (TEAMID)
SIGNING_IDENTITY_PKG=Developer ID Installer: Your Organization (TEAMID)

# notarytool keychain profile name (from xcrun notarytool store-credentials).
NOTARIZATION_PROFILE=munkistudio-notary
