# MunkiStudio release signing configuration.
# Copy this file to .env (gitignored) and fill in your values.
#
# List the Developer ID certificates in your keychain with:
#   make list-identities

# Marketing version baked into the .app and the .pkg.
# Optional — defaults to 1.0.0 when unset.
# VERSION=1.0.0

# Apple Developer Team ID.
TEAM_ID=YOURTEAMID

# Developer ID Application certificate — signs the .app bundle.
SIGNING_IDENTITY_APP=Developer ID Application: Your Organization (YOURTEAMID)

# Developer ID Installer certificate — signs the .pkg.
SIGNING_IDENTITY_INSTALLER=Developer ID Installer: Your Organization (YOURTEAMID)

# Notarization — an Apple ID plus an app-specific password.
NOTARIZATION_APPLE_ID=notarization@example.com
NOTARIZATION_PASSWORD=abcd-efgh-ijkl-mnop

# Alternatively, a notarytool keychain profile created once with
# `xcrun notarytool store-credentials`. When set, this takes precedence
# over the Apple ID + password above.
# NOTARIZATION_PROFILE=munkistudio-notary
