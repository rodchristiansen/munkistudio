# macOS
.DS_Store

# Xcode
# Anchored to the repo root — an unanchored `build/` also matches the
# `Features/Build/` source directory on case-insensitive filesystems.
/build/
DerivedData/
*.xcuserstate
*.xcuserdatad
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
.build/
Packages/*/.build/
Packages/*/.swiftpm/
Package.resolved

# Xcode workspace state
*.xcworkspace/xcuserdata/

# Misc
*.log
.env
